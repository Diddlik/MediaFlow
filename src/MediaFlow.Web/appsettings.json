{
  "MediaFlow": {
    "DryRun": true,
    "ReconciliationIntervalSeconds": 300,
    "Database": {
      "Path": "/app/data/mediaflow.db"
    },
    "AllowedRoots": [
      "/sources",
      "/destinations"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
