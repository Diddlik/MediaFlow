{
  "MediaFlow": {
    "DryRun": true,
    "ReconciliationIntervalSeconds": 300,
    "Automation": {
      "Enabled": true,
      "InitialDelaySeconds": 10,
      "MaxFilesPerSharePerCycle": 200,
      "AllowFilesystemTimestampFallback": false
    },
    "Database": {
      "Path": "data/mediaflow.db"
    },
    "AllowedRoots": [
      "/sources",
      "/destinations"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
